---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title type="text" xml:lang="ro">{{ site.title | xml_escape }}</title>
  <subtitle type="text" xml:lang="ro">{{ site.description | xml_escape }}</subtitle>
  <link rel="self" type="application/atom+xml" href="{{ site.url }}{{ site.baseurl }}/feed.xml" />
  <link rel="alternate" type="text/html" href="{{ site.url }}{{ site.baseurl }}/" />
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ site.url }}{{ site.baseurl }}/</id>
  <author>
    <name>Laurence Deer</name>
  </author>

  {% assign all_pages = site.pages | where: "layout", "protocol" | sort: "ultima_actualizare" | reverse %}
  {% for page in all_pages limit: 10 %}
  <entry>
    <title>{{ page.title | xml_escape }}</title>
    <link rel="alternate" type="text/html" href="{{ site.url }}{{ site.baseurl }}{{ page.url }}" />
    <id>{{ site.url }}{{ site.baseurl }}{{ page.url }}</id>
    <updated>{{ page.ultima_actualizare | date_to_xmlschema | default: site.time | date_to_xmlschema }}</updated>
    <summary type="html">{{ page.description | xml_escape | default: page.title | xml_escape }}</summary>
    <content type="html" xml:base="{{ site.url }}{{ site.baseurl }}{{ page.url }}">{{ page.content | xml_escape }}</content>
  </entry>
  {% endfor %}
</feed>
